# =============================================================================
# Glaze Board — paste your workbench secrets here
# =============================================================================
# This file is VISIBLE in Cursor Cloud so you can edit it.
# When you're done filling every blank, reply: "secrets filled"
# (do not paste the values in chat). The agent will copy this file to
# .env.local without opening it.
#
# Never point these at the live (glazeboard-live) database.
# =============================================================================

# Neon connection string for role glaze_app (app reads/writes; owns nothing)
DATABASE_URL=

# Neon connection string for the OWNER role (used by: npm run migrate)
MIGRATE_DATABASE_URL=

# Generate once with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Local app URL (leave as-is for cloud/dev unless you know you need another)
BETTER_AUTH_URL=http://localhost:3000

# Resend API key — password reset / invites
RESEND_API_KEY=

# Optional until public service form (Phase F) — leave blank for now if you want
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
