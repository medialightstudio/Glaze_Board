#!/usr/bin/env node
// Rebuilds the workbench from all migrations (+ seed if present). Refuses live URLs.

const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");
const { Pool } = require("@neondatabase/serverless");

function loadEnvLocal() {
  const p = path.resolve(".env.local");
  if (!fs.existsSync(p)) return;
  for (const line of fs.readFileSync(p, "utf8").split("\n")) {
    const m = line.match(/^([A-Z0-9_]+)=(.*)$/);
    if (!m) continue;
    if (process.env[m[1]] === undefined) process.env[m[1]] = m[2];
  }
}

function looksLive(url) {
  const u = (url || "").toLowerCase();
  return u.includes("glazeboard-live") || u.includes("live");
}

async function main() {
  loadEnvLocal();
  const url = process.env.MIGRATE_DATABASE_URL;
  if (!url) {
    console.error("db:reset FAIL — MIGRATE_DATABASE_URL is blank.");
    process.exit(1);
  }
  if (looksLive(url)) {
    console.error(
      "db:reset FAIL — refuses to run against a live connection string.",
    );
    process.exit(1);
  }

  const pool = new Pool({ connectionString: url });
  const client = await pool.connect();
  try {
    console.log("db:reset — dropping public schema…");
    await client.query("DROP SCHEMA public CASCADE");
    await client.query("CREATE SCHEMA public");
    await client.query("GRANT ALL ON SCHEMA public TO public");
  } finally {
    client.release();
    await pool.end();
  }

  const migrate = spawnSync("node", ["scripts/migrate"], {
    stdio: "inherit",
    env: process.env,
  });
  if (migrate.status !== 0) process.exit(migrate.status || 1);

  if (fs.existsSync("scripts/seed")) {
    const seed = spawnSync("node", ["scripts/seed"], {
      stdio: "inherit",
      env: process.env,
    });
    if (seed.status !== 0) process.exit(seed.status || 1);
  }
  console.log("db:reset OK");
}

main().catch((err) => {
  console.error("db:reset FAIL —", err.message || err);
  process.exit(1);
});
