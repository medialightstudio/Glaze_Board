# Workbench template — copy to .env.local and fill blanks.
# Never point these at the live database.

DATABASE_URL=
MIGRATE_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=

# Optional (Phase F)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Push (Phase G) — generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@glazeboard.com

# Automation / Money / Phone (fill when connecting; never commit values)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
QB_CLIENT_ID=
QB_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=
BRIDGE_SHARED_SECRET=
DEFAULT_COMPANY_ID=
QB_WEBHOOK_SECRET=
