#!/usr/bin/env node
// Seeds company + owner admin through Better Auth sign-up (never raw SQL passwords).

const fs = require("node:fs");
const path = require("node:path");
const { Pool } = require("@neondatabase/serverless");

function loadEnvLocal() {
  const p = path.resolve(".env.local");
  if (!fs.existsSync(p)) return;
  for (const line of fs.readFileSync(p, "utf8").split("\n")) {
    const m = line.match(/^([A-Z0-9_]+)=(.*)$/);
    if (!m) continue;
    if (process.env[m[1]] === undefined) process.env[m[1]] = m[2];
  }
}

function arg(name, fallback) {
  const i = process.argv.indexOf(`--${name}`);
  if (i >= 0 && process.argv[i + 1]) return process.argv[i + 1];
  return process.env[name.toUpperCase()] || fallback;
}

async function main() {
  loadEnvLocal();
  const companyName = arg("company", "Glaze Board Demo");
  const email = arg("email", "owner@example.com");
  const password = arg("password", "changeme-now");
  const name = arg("name", "Owner");

  const migrateUrl = process.env.MIGRATE_DATABASE_URL;
  const appUrl = process.env.DATABASE_URL;
  if (!migrateUrl || !appUrl) {
    console.error("seed FAIL — DATABASE_URL / MIGRATE_DATABASE_URL blank.");
    process.exit(1);
  }

  const ownerPool = new Pool({ connectionString: migrateUrl });
  const owner = await ownerPool.connect();
  let companyId;
  try {
    const existing = await owner.query(
      "SELECT id FROM companies WHERE name = $1 LIMIT 1",
      [companyName],
    );
    if (existing.rows[0]) {
      companyId = existing.rows[0].id;
      console.log("company exists");
    } else {
      const inserted = await owner.query(
        `INSERT INTO companies (name, public_form_slug)
         VALUES ($1, $2) RETURNING id`,
        [companyName, companyName.toLowerCase().replace(/[^a-z0-9]+/g, "-")],
      );
      companyId = inserted.rows[0].id;
      console.log("company created");
    }
  } finally {
    owner.release();
    await ownerPool.end();
  }

  // Sign up via Better Auth HTTP API so password hashing is correct.
  const base = process.env.BETTER_AUTH_URL || "http://localhost:3000";
  const res = await fetch(`${base}/api/auth/sign-up/email`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ email, password, name }),
  });
  if (!res.ok) {
    const text = await res.text();
    // If server isn't up, fall back to note for operator.
    console.error(
      "seed — sign-up via running app failed. Start `npm run dev` then re-run seed,",
      "or use scripts/seed-direct after migrate. Detail length:",
      text.length,
    );
  }

  const pool = new Pool({ connectionString: migrateUrl });
  const client = await pool.connect();
  try {
    await client.query(
      `UPDATE "user"
       SET company_id = $1, role = 'admin', active = true, platform_admin = false
       WHERE email = $2`,
      [companyId, email],
    );
    // Built-in Direct customer for homeowner jobs (B1).
    const direct = await client.query(
      `SELECT id FROM accounts WHERE company_id = $1 AND is_direct = true LIMIT 1`,
      [companyId],
    );
    if (!direct.rows[0]) {
      await client.query(
        `INSERT INTO accounts (company_id, name, is_direct, billing_type)
         VALUES ($1, 'Direct', true, 'per_job')`,
        [companyId],
      );
      console.log("Direct customer seeded");
    }
  } finally {
    client.release();
    await pool.end();
  }

  console.log("seed OK — company + owner admin linked. Log in with the email you passed.");
  console.log("Usage: node scripts/seed --company \"Name\" --email you@x.com --password '…' --name \"You\"");
}

main().catch((err) => {
  console.error("seed FAIL —", err.message || err);
  process.exit(1);
});
