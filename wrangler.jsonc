/**
 * Cloudflare Worker config for Glaze Board (OpenNext).
 * Domain: glazeboard.com — attach custom domains here and in the dashboard.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "glazeboard",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{ "pattern": "glazeboard.com", "custom_domain": true },
		{ "pattern": "www.glazeboard.com", "custom_domain": true }
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "glazeboard"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOCS",
			"bucket_name": "docs",
			"preview_bucket_name": "docs"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://glazeboard.com",
		"NEXTJS_ENV": "production"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
