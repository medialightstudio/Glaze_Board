#!/usr/bin/env node
// Asserts cross-company isolation and that glaze_app owns no tables.

const fs = require("node:fs");
const path = require("node:path");
const { Pool } = require("@neondatabase/serverless");
const { randomUUID } = require("node:crypto");

function loadEnvLocal() {
  const p = path.resolve(".env.local");
  if (!fs.existsSync(p)) return;
  for (const line of fs.readFileSync(p, "utf8").split("\n")) {
    const m = line.match(/^([A-Z0-9_]+)=(.*)$/);
    if (!m) continue;
    if (process.env[m[1]] === undefined) process.env[m[1]] = m[2];
  }
}

async function main() {
  loadEnvLocal();
  const appUrl = process.env.DATABASE_URL;
  const ownerUrl = process.env.MIGRATE_DATABASE_URL;
  if (!appUrl || !ownerUrl) {
    console.error("check:rls FAIL — DATABASE_URL / MIGRATE_DATABASE_URL blank.");
    process.exit(1);
  }

  const ownerPool = new Pool({ connectionString: ownerUrl });
  const appPool = new Pool({ connectionString: appUrl });
  const suffix = randomUUID().slice(0, 8);
  const coA = randomUUID();
  const coB = randomUUID();
  const userA = `rls-a-${suffix}@example.com`;
  const userB = `rls-b-${suffix}@example.com`;

  const owner = await ownerPool.connect();
  try {
    await owner.query(
      `INSERT INTO companies (id, name) VALUES ($1, $2), ($3, $4)`,
      [coA, `RLS A ${suffix}`, coB, `RLS B ${suffix}`],
    );
    // Create users through library-shaped rows with placeholder passwords — sign-up preferred when app up.
    // check script uses owner to insert minimal user rows then verifies RLS via app pool set_config.
    const idA = randomUUID();
    const idB = randomUUID();
    await owner.query(
      `INSERT INTO "user" (id, name, email, "emailVerified", company_id, role, active)
       VALUES ($1, 'A', $2, true, $3, 'admin', true),
              ($4, 'B', $5, true, $6, 'admin', true)`,
      [idA, userA, coA, idB, userB, coB],
    );

    // App account owns no tables
    const owns = await owner.query(
      `SELECT tablename FROM pg_tables
       WHERE schemaname = 'public' AND tableowner = 'glaze_app'`,
    );
    if (owns.rows.length > 0) {
      console.error("check:rls FAIL — glaze_app owns tables:", owns.rows);
      process.exit(1);
    }

    // Cross-company probe via app pool + set_config
    const app = await appPool.connect();
    try {
      await app.query("BEGIN");
      await app.query("SELECT set_config('app.company_id', $1, true)", [coA]);
      await app.query("SELECT set_config('app.role', 'admin', true)");
      const seen = await app.query("SELECT id FROM companies");
      await app.query("COMMIT");
      const ids = seen.rows.map((r) => r.id);
      if (ids.includes(coB) || !ids.includes(coA)) {
        console.error("check:rls FAIL — company isolation leak via withUser-equivalent.");
        process.exit(1);
      }

      await app.query("BEGIN");
      await app.query("SELECT set_config('app.company_id', $1, true)", [coA]);
      const raw = await app.query(
        "SELECT id FROM companies WHERE id = $1",
        [coB],
      );
      await app.query("COMMIT");
      if (raw.rows.length !== 0) {
        console.error("check:rls FAIL — raw policy probe returned foreign company.");
        process.exit(1);
      }
    } finally {
      app.release();
    }

    // cleanup
    await owner.query(`DELETE FROM "user" WHERE email IN ($1, $2)`, [
      userA,
      userB,
    ]);
    await owner.query(`DELETE FROM companies WHERE id IN ($1, $2)`, [coA, coB]);
    console.log("check:rls OK");
  } finally {
    owner.release();
    await ownerPool.end();
    await appPool.end();
  }
}

main().catch((err) => {
  console.error("check:rls FAIL —", err.message || err);
  process.exit(1);
});
