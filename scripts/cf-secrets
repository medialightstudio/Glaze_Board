#!/usr/bin/env node
// Pushes secrets from .env.local to the Cloudflare Worker (never prints values).
// Requires: npx wrangler login   OR   CLOUDFLARE_API_TOKEN in the environment.

const fs = require("node:fs");
const { spawnSync } = require("node:child_process");

const KEYS = [
  "DATABASE_URL",
  "MIGRATE_DATABASE_URL",
  "BETTER_AUTH_SECRET",
  "RESEND_API_KEY",
  "VAPID_PUBLIC_KEY",
  "VAPID_PRIVATE_KEY",
  "VAPID_SUBJECT",
  "TURNSTILE_SECRET_KEY",
  "BETTER_AUTH_API_KEY",
];

function loadEnvLocal() {
  const map = {};
  if (!fs.existsSync(".env.local")) return map;
  for (const line of fs.readFileSync(".env.local", "utf8").split("\n")) {
    const m = line.match(/^([A-Z0-9_]+)=(.*)$/);
    if (m) map[m[1]] = m[2];
  }
  return map;
}

const env = loadEnvLocal();
let ok = 0;
let skip = 0;
let fail = 0;

for (const key of KEYS) {
  const val = (env[key] || "").trim();
  if (!val) {
    console.log(`skip ${key} (blank)`);
    skip += 1;
    continue;
  }
  const r = spawnSync("npx", ["wrangler", "secret", "put", key], {
    input: val,
    encoding: "utf8",
  });
  if (r.status === 0) {
    console.log(`ok   ${key}`);
    ok += 1;
  } else {
    console.error(`fail ${key}`);
    if (r.stderr) {
      // Avoid printing secret material; show only non-value hints.
      const hint = r.stderr.split("\n").find((l) => /error|auth|login|permission/i.test(l));
      if (hint) console.error(hint.slice(0, 200));
    }
    fail += 1;
  }
}

console.log(`cf-secrets done — ok=${ok} skip=${skip} fail=${fail}`);
if (fail) process.exit(1);
